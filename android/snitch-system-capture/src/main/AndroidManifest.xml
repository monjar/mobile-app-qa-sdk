<?xml version="1.0" encoding="utf-8"?>
<!--
  System capture (MediaProjection) for Snitch. Adds a translucent activity that
  asks for screen-recording consent and a foreground service of type
  mediaProjection that owns the projection while the app runs.
  POST_NOTIFICATIONS is declared but never requested: without it the
  foreground-service notification is simply not shown on Android 13+.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <activity
            android:name="io.github.monjar.snitch.system.SystemCaptureActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name="io.github.monjar.snitch.system.SnitchProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
