{
  "expo": {
    "name": "Todo",
    "slug": "snitch-todo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "io.github.monjar.snitch.todo",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "io.github.monjar.snitch.todo"
    },
    "plugins": [
      [
        "react-native-snitch",
        {
          "serverUrl": "http://127.0.0.1:8080",
          "ingestKey": "snitch_pk_0123456789ABCDEFGHJKMNPQRS",
          "captureNetwork": true
        }
      ],
      "./plugins/withFmtXcode26Patch.js"
    ]
  }
}
