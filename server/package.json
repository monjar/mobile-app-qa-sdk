{
  "name": "snitch-server",
  "private": true,
  "version": "0.1.1",
  "description": "Snitch server: report intake, ticket queue, admin dashboard API and escalation worker.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "snitch": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
